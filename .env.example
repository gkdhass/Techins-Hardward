# Root environment variables for Vercel deployment

# MongoDB Atlas
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/techins-hardware?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_min_32_chars
JWT_EXPIRE=7d

# URLs
CLIENT_URL=https://your-app.vercel.app
VITE_API_URL=/api

# Cloudinary Configuration (for file uploads on Vercel)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# File Upload
MAX_FILE_SIZE=5242880

# Environment
NODE_ENV=production
